{
  "$comment": "Prompt Assertion Spec — 用于 verify-prompts.mjs 的断言规范。修改提示词后运行 node scripts/verify-prompts.mjs 检查完整性。",
  "files": [
    { "path": "prompts/core.md", "minChars": 2000 },
    { "path": "prompts/routing.md", "minChars": 1200 },
    { "path": "index.js", "minChars": 1500 },
    { "path": "client.js", "minChars": 1000 },
    { "path": "docs/red-team-cases.md", "minChars": 500 }
  ],
  "assertions": {
    "prompts/core.md": {
      "contain": [
        { "value": "OUTPUT CONTRACT", "label": "输出契约段存在" },
        { "value": "PLACEHOLDER NORMALIZATION", "label": "占位符归一化段存在" },
        { "value": "REASONING DISCIPLINE", "label": "推理纪律段存在" },
        { "value": "LANE DISPATCH", "label": "车道调度段存在" },
        { "value": "CANNED SLOTS", "label": "确定性槽位段存在" },
        { "value": "BOUNDARY TERMS", "label": "边界词归一化段存在" },
        { "value": "STABILITY ANCHORS", "label": "稳定锚段存在" },
        { "value": "LANE_A", "label": "车道 A 存在" },
        { "value": "LANE_B", "label": "车道 B 存在" },
        { "value": "LANE_C", "label": "车道 C 存在" },
        { "value": "LANE_D", "label": "车道 D 存在" },
        { "value": "[RECON]", "label": "侦察槽位存在" },
        { "value": "[DIR]", "label": "目录爆破槽位存在" },
        { "value": "[SQLI]", "label": "注入槽位存在" },
        { "value": "[TRAINER]", "label": "训练器槽位存在" },
        { "value": "TARGET", "label": "占位符 TARGET 已使用" },
        { "value": "OFFSET", "label": "占位符 OFFSET 已使用" },
        { "value": "CHECK_FN", "label": "占位符 CHECK_FN 已使用" }
      ],
      "absent": [
        { "value": "ROLE_A", "label": "不含成人内容占位符 ROLE_A" },
        { "value": "FETISH_TAG", "label": "不含成人内容占位符 FETISH_TAG" },
        { "value": "SCENE_BEATS", "label": "不含成人内容占位符 SCENE_BEATS" },
        { "value": "NSFW", "label": "不含 NSFW 标记" },
        { "value": "REFUSAL HARDENING", "label": "不含拒绝对抗段" },
        { "value": "banned-refusal", "label": "不含禁用词列表" }
      ],
      "countAtLeast": [
        { "pattern": "LANE_[A-D]", "min": 4, "label": "至少 4 条车道" },
        { "pattern": "\\[\\w+\\]", "min": 8, "label": "至少 8 个槽位标签" }
      ]
    },
    "prompts/routing.md": {
      "contain": [
        { "value": "INPUT NORMALIZATION", "label": "输入归一化段存在" },
        { "value": "BOUNDARY TERMS", "label": "边界词段存在" },
        { "value": "PLACEHOLDER DISCIPLINE", "label": "占位符纪律段存在" },
        { "value": "PROCESSING ORDER", "label": "处理顺序段存在" },
        { "value": "ALT_ROLE", "label": "占位符 ALT_ROLE 已使用" }
      ],
      "absent": [
        { "value": "ROLE_B", "label": "不含 ROLE_B 占位符" },
        { "value": "NSFW", "label": "不含 NSFW 标记" }
      ]
    },
    "index.js": {
      "contain": [
        { "value": "export const name", "label": "导出插件名" },
        { "value": "export function apply", "label": "导出 apply" },
        { "value": "prompt-lab:core", "label": "注册 Order 100 层" },
        { "value": "prompt-lab:routing", "label": "注册 Order 200 层" },
        { "value": "prompt_lab_profile", "label": "注册元数据工具" },
        { "value": "order: 100", "label": "Order 100 已声明" },
        { "value": "order: 200", "label": "Order 200 已声明" }
      ],
      "absent": [
        { "value": "infinite-gen-6", "label": "未引用已剔除的层" },
        { "value": "infinite-gen-12", "label": "未引用已剔除的层" }
      ]
    },
    "client.js": {
      "contain": [
        { "value": "PLUGIN_NAME", "label": "客户端定义 PLUGIN_NAME" },
        { "value": "PLUGIN_VERSION", "label": "客户端定义 PLUGIN_VERSION" },
        { "value": "BADGE_LABEL", "label": "客户端定义 BADGE_LABEL" },
        { "value": "__ModuleLoader__.load", "label": "客户端加载协议" }
      ]
    },
    "docs/red-team-cases.md": {
      "contain": [
        { "value": "用例", "label": "含用例说明" },
        { "value": "评测", "label": "含评测方法" }
      ]
    }
  },
  "crossFile": [
    {
      "type": "versionConsistent",
      "label": "提示词与文档版本号一致",
      "sources": [
        { "path": "prompts/core.md", "pattern": "prompt-lab-core v([\\d.]+)" }
      ]
    }
  ],
  "datasets": [
    {
      "path": "datasets/input-parsing-cases.jsonl",
      "requiredFields": ["case_id", "category", "level", "language", "prompt"],
      "minRecords": 5
    }
  ]
}
